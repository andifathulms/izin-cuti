{
  "name": "izin-cuti",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side docx template mapper and filler. Nothing leaves the device.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && touch out/.nojekyll",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:roundtrip": "vitest run tests/roundtrip",
    "test:package": "vitest run tests/package",
    "test:escape": "vitest run tests/escape",
    "test:drift": "vitest run tests/drift",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "blank": "tsx scripts/blank.mts",
    "inspect": "tsx scripts/inspect.mts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3",
    "tsx": "^4.16.2"
  },
  "packageManager": "pnpm@9.15.9"
}
